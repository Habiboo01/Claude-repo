<section class="showcase" id="Showcase-{{ section.id }}">
  {% if section.settings.heading != blank %}
    <div class="showcase__head">
      <h2 class="clip-reveal"><span>{{ section.settings.heading }}</span></h2>
      {% if section.settings.view_all_url != blank %}
        <a href="{{ section.settings.view_all_url }}" class="label reveal" style="display:inline-flex;gap:8px;">View All →</a>
      {% endif %}
    </div>
  {% endif %}

  {% for block in section.blocks %}
    {%- assign block_product = all_products[block.settings.product] -%}
    {%- assign row_mod = forloop.index | modulo: 2 -%}
    {%- if row_mod == 0 -%}
      {%- assign is_reverse = true -%}
    {%- else -%}
      {%- assign is_reverse = false -%}
    {%- endif -%}
    <div class="showcase__item{% if is_reverse %} showcase__item--reverse{% endif %}" {{ block.shopify_attributes }}>
      <div class="showcase__media showcase__media--slide{% if is_reverse %}-right{% else %}-left{% endif %}" style="overflow:hidden;">
        <span class="showcase__index">0{{ forloop.index }} / 0{{ section.blocks.size }}</span>
        {% if block.settings.image != blank %}
          <img src="{{ block.settings.image | image_url: width: 1200 }}" alt="{{ block.settings.image.alt | escape }}" loading="lazy">
        {% elsif block_product != blank and block_product.featured_image %}
          <img src="{{ block_product.featured_image | image_url: width: 1200 }}" alt="{{ block_product.title | escape }}" loading="lazy">
        {% else %}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {% endif %}
      </div>

      <div class="showcase__content showcase__content--slide{% if is_reverse %}-left{% else %}-right{% endif %}">
        {% if block.settings.eyebrow != blank %}
          <p class="showcase__eyebrow label showcase__animate" style="--d:0">{{ block.settings.eyebrow }}</p>
        {% endif %}
        <h3 class="showcase__title showcase__animate" style="--d:1">
          {% if block.settings.title != blank %}{{ block.settings.title }}
          {% elsif block_product != blank %}{{ block_product.title }}{% endif %}
        </h3>
        {% if block.settings.description != blank %}
          <p class="showcase__desc showcase__animate" style="--d:2">{{ block.settings.description }}</p>
        {% elsif block_product != blank %}
          <p class="showcase__desc showcase__animate" style="--d:2">{{ block_product.description | strip_html | truncatewords: 30 }}</p>
        {% endif %}
        {% if block_product != blank %}
          <p class="showcase__price showcase__animate" style="--d:3">{{ block_product.price | money }}</p>
        {% endif %}
        <a href="{% if block_product != blank %}{{ block_product.url }}{% else %}{{ block.settings.link_url }}{% endif %}" class="btn-pill showcase__animate" style="--d:4" data-magnetic>
          {{ block.settings.button_label | default: 'View Product' }}
          <svg width="15" height="15" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </div>
  {% endfor %}
</section>

{% schema %}
{
  "name": "Product Showcase",
  "tag": "section",
  "class": "section-showcase",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "heading", "label": "Section heading", "default": "Featured" },
    { "type": "url", "id": "view_all_url", "label": "'View all' link" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Featured item",
      "settings": [
        { "type": "product", "id": "product", "label": "Product (auto-fills title, price, link)" },
        { "type": "image_picker", "id": "image", "label": "Image override (optional)" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "New" },
        { "type": "text", "id": "title", "label": "Title override (optional)" },
        { "type": "textarea", "id": "description", "label": "Description override (optional)" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "View Product" },
        { "type": "url", "id": "link_url", "label": "Button link (used if no product)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Showcase",
      "blocks": [
        { "type": "feature", "settings": { "eyebrow": "Signature" } },
        { "type": "feature", "settings": { "eyebrow": "Best Seller" } },
        { "type": "feature", "settings": { "eyebrow": "New Arrival" } },
        { "type": "feature", "settings": { "eyebrow": "Limited" } },
        { "type": "feature", "settings": { "eyebrow": "Exclusive" } }
      ]
    }
  ]
}
{% endschema %}
