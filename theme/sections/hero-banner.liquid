<div class="hero" id="Hero-{{ section.id }}">
  <div class="hero__media">
    {% if section.settings.video != blank %}
      {{ section.settings.video | video_tag: autoplay: true, muted: true, loop: true, playsinline: true, controls: false }}
    {% elsif section.settings.video_url != blank %}
      {{ section.settings.video_url | external_video_tag }}
    {% elsif section.settings.image != blank %}
      <img
        src="{{ section.settings.image | image_url: width: 2400 }}"
        srcset="{{ section.settings.image | image_url: width: 900 }} 900w,
                {{ section.settings.image | image_url: width: 1400 }} 1400w,
                {{ section.settings.image | image_url: width: 2400 }} 2400w"
        sizes="100vw"
        alt="{{ section.settings.image.alt | escape }}"
        loading="eager" fetchpriority="high">
    {% else %}
      <div style="width:100%;height:100%;background:var(--color-card);"></div>
    {% endif %}
  </div>

  <div class="hero__overlay"></div>

  {% if section.settings.video != blank and section.settings.show_play_button %}
    <button class="hero__play" aria-label="Play video">Play<br>Reel</button>
  {% endif %}

  <div class="hero__content">
    <div>
      {% if section.settings.eyebrow != blank %}
        <p class="hero__eyebrow label" style="color:rgba(255,255,255,0.7);">{{ section.settings.eyebrow }}</p>
      {% endif %}
      <h1 class="hero__title">
        {% assign lines = section.settings.heading | split: '|' %}
        {% for line in lines %}
          <span class="clip-reveal"><span class="hero__title-line">{{ line }}</span></span>
        {% endfor %}
      </h1>
    </div>

    <div>
      {% if section.settings.tagline != blank %}
        <p class="hero__tagline">{{ section.settings.tagline }}</p>
      {% endif %}
      {% if section.settings.cta_label != blank %}
        <a href="{{ section.settings.cta_url }}" class="hero__cta" data-magnetic>
          {{ section.settings.cta_label }}
          <svg width="15" height="15" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      {% endif %}
    </div>
  </div>

  {% if section.settings.show_scroll_indicator %}
    <div class="hero__scroll" aria-hidden="true">
      <span>Scroll</span>
      <div class="hero__scroll-line"></div>
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Hero Banner",
  "tag": "section",
  "class": "section-hero",
  "settings": [
    { "type": "paragraph", "content": "Add a background video for a motion hero, or fall back to an image. All editable here." },
    { "type": "video", "id": "video", "label": "Background video (Shopify-hosted)" },
    { "type": "video_url", "id": "video_url", "label": "Or video URL (YouTube/Vimeo)", "accept": ["youtube", "vimeo"] },
    { "type": "image_picker", "id": "image", "label": "Background image (fallback)" },
    { "type": "checkbox", "id": "show_play_button", "label": "Show play button over video", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow text", "default": "It starts with a whisper" },
    { "type": "textarea", "id": "heading", "label": "Heading (use | to split lines)", "default": "Multilayered|beauty" },
    { "type": "textarea", "id": "tagline", "label": "Tagline", "default": "Multilayered beauty for those who live between worlds." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Shop the collection" },
    { "type": "url", "id": "cta_url", "label": "Button URL" },
    { "type": "checkbox", "id": "show_scroll_indicator", "label": "Show scroll indicator", "default": true }
  ],
  "presets": [{ "name": "Hero Banner" }]
}
{% endschema %}
