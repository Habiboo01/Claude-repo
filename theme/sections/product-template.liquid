{%- assign current_variant = product.selected_or_first_available_variant -%}

<div class="product-page">
  <div class="product-layout">

    <div class="product-gallery">
      <div class="product-gallery__main">
        <img id="MainProductImage"
             src="{{ product.featured_image | image_url: width: 1400 }}"
             alt="{{ product.featured_image.alt | escape }}" loading="eager">
      </div>
      {% if product.images.size > 1 %}
        <div class="product-gallery__thumbs">
          {% for image in product.images %}
            <button class="product-gallery__thumb{% if forloop.first %} active{% endif %}" aria-label="View image {{ forloop.index }}">
              <img src="{{ image | image_url: width: 240 }}" data-full="{{ image | image_url: width: 1400 }}" alt="{{ image.alt | escape }}" loading="lazy">
            </button>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <div class="product-info">
      {% if product.vendor != blank %}<p class="product-info__vendor">{{ product.vendor }}</p>{% endif %}
      <h1 class="product-info__title">{{ product.title }}</h1>

      <div class="product-info__price{% if current_variant.compare_at_price > current_variant.price %} product-info__price--sale{% endif %}">
        <span class="product-info__price--current">{{ current_variant.price | money }}</span>
        {% if current_variant.compare_at_price > current_variant.price %}<s>{{ current_variant.compare_at_price | money }}</s>{% endif %}
      </div>

      <div class="product-divider"></div>

      <form data-product-form data-variants="{{ product.variants | json | escape }}">
        <input type="hidden" name="id" value="{{ current_variant.id }}">

        {% for option in product.options_with_values %}
          {%- assign opt_name = option.name | downcase -%}
          {% if opt_name == 'color' or opt_name == 'colour' %}
            <div class="variant-label">
              <span>{{ option.name }}</span>
              <span data-color-value>{{ option.selected_value }}</span>
            </div>
            <div class="color-options">
              {% for value in option.values %}
                <button type="button" class="color-btn{% if option.selected_value == value %} selected{% endif %}"
                        data-option-btn data-option-position="{{ option.position }}" data-value="{{ value | escape }}" data-is-color="true"
                        style="background-color: {{ value | downcase | replace: ' ', '' }};"
                        aria-label="{{ value }}" title="{{ value }}"></button>
              {% endfor %}
            </div>
          {% else %}
            <div class="variant-label"><span>{{ option.name }}</span></div>
            <div class="size-options">
              {% for value in option.values %}
                {%- assign is_avail = false -%}
                {% for v in product.variants %}
                  {% if v.options contains value and v.available %}{% assign is_avail = true %}{% endif %}
                {% endfor %}
                <button type="button" class="size-btn{% unless is_avail %} unavailable{% endunless %}{% if option.selected_value == value %} selected{% endif %}"
                        data-option-btn data-option-position="{{ option.position }}" data-value="{{ value | escape }}">{{ value }}</button>
              {% endfor %}
            </div>
          {% endif %}
        {% endfor %}

        <div class="product-divider"></div>

        <button type="submit" class="btn-add-to-cart" {% unless current_variant.available %}disabled{% endunless %}>
          <span>{% if current_variant.available %}Add to Cart{% else %}Sold Out{% endif %}</span>
        </button>
        <a href="/checkout" class="btn-secondary" style="display:block;text-align:center;margin-top:10px;text-decoration:none;">Buy Now</a>
      </form>

      <div class="product-divider"></div>

      {% if product.description != blank %}
        <div class="product-info__description">{{ product.description }}</div>
        <div class="product-divider"></div>
      {% endif %}

      <div class="product-accordion">
        {% for block in section.blocks %}
          <div class="accordion-item" {{ block.shopify_attributes }}>
            <button class="accordion-trigger" type="button">
              <span>{{ block.settings.title }}</span><span class="accordion-icon"></span>
            </button>
            <div class="accordion-content"><div class="accordion-content__inner">{{ block.settings.content }}</div></div>
          </div>
        {% endfor %}
      </div>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Product",
  "tag": "section",
  "class": "section-product",
  "blocks": [
    {
      "type": "accordion",
      "name": "Accordion row",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Details" },
        { "type": "richtext", "id": "content", "label": "Content", "default": "<p>Add product details here.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product",
      "blocks": [
        { "type": "accordion", "settings": { "title": "Shipping & Returns", "content": "<p>Free shipping on orders over 500 EGP. Returns within 14 days.</p>" } },
        { "type": "accordion", "settings": { "title": "Size & Fit", "content": "<p>Relaxed, intentional fit. If between sizes, size up.</p>" } },
        { "type": "accordion", "settings": { "title": "Care", "content": "<p>Cold wash. Do not tumble dry. Iron low.</p>" } }
      ]
    }
  ]
}
{% endschema %}
