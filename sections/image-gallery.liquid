<section class="gallery" id="Gallery-{{ section.id }}">
  {% if section.settings.eyebrow != blank or section.settings.title != blank %}
    <div class="gallery__head">
      {% if section.settings.eyebrow != blank %}
        <p class="gallery__eyebrow reveal">{{ section.settings.eyebrow }}</p>
      {% endif %}
      {% if section.settings.title != blank %}
        <h2 class="gallery__title clip-reveal"><span>{{ section.settings.title }}</span></h2>
      {% endif %}
    </div>
  {% endif %}

  <div class="gallery__grid stagger"
       style="--cols: {{ section.settings.columns }}; --gap: {{ section.settings.gap }}px; --ratio: {{ section.settings.ratio }};">
    {% for block in section.blocks %}
      {%- assign tall = block.settings.tall -%}
      {%- if block.settings.link != blank -%}
        <a href="{{ block.settings.link }}" class="gallery__item reveal{% if tall %} gallery__item--tall{% endif %}" {{ block.shopify_attributes }}>
      {%- else -%}
        <div class="gallery__item reveal{% if tall %} gallery__item--tall{% endif %}" {{ block.shopify_attributes }}>
      {%- endif -%}
        {% if block.settings.image != blank %}
          <img
            src="{{ block.settings.image | image_url: width: 900 }}"
            srcset="{{ block.settings.image | image_url: width: 500 }} 500w, {{ block.settings.image | image_url: width: 900 }} 900w, {{ block.settings.image | image_url: width: 1300 }} 1300w"
            sizes="(min-width:900px) 33vw, 50vw"
            alt="{{ block.settings.image.alt | escape }}" loading="lazy">
        {% else %}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {% endif %}
      {%- if block.settings.link != blank -%}</a>{%- else -%}</div>{%- endif -%}
    {% endfor %}
  </div>

  {% if section.settings.handle != blank %}
    <p class="gallery__handle reveal">{{ section.settings.handle }}</p>
  {% endif %}
</section>

{% schema %}
{
  "name": "Image Gallery",
  "tag": "section",
  "class": "section-gallery",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Gallery" },
    { "type": "text", "id": "title", "label": "Title", "default": "In the wild" },
    { "type": "range", "id": "columns", "label": "Columns (desktop)", "min": 2, "max": 5, "step": 1, "default": 3 },
    { "type": "range", "id": "gap", "label": "Gap (px)", "min": 0, "max": 32, "step": 2, "default": 8 },
    {
      "type": "select", "id": "ratio", "label": "Image ratio", "default": "1",
      "options": [
        { "value": "1", "label": "Square" },
        { "value": "4/5", "label": "Portrait" },
        { "value": "3/4", "label": "Tall portrait" },
        { "value": "4/3", "label": "Landscape" }
      ]
    },
    { "type": "text", "id": "handle", "label": "Caption / handle under gallery", "default": "@yourbrand" }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "url", "id": "link", "label": "Link (optional)" },
        { "type": "checkbox", "id": "tall", "label": "Make this image tall (span 2 rows)", "default": false }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Image Gallery",
      "blocks": [
        { "type": "image" }, { "type": "image" }, { "type": "image" },
        { "type": "image" }, { "type": "image" }, { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
