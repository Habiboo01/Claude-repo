<div class="marquee" aria-hidden="true">
  <div class="marquee__track">
    {% for n in (1..2) %}
      {% for block in section.blocks %}
        <span class="marquee__item">{{ block.settings.text }}</span>
      {% endfor %}
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Marquee Ticker",
  "tag": "section",
  "class": "section-marquee",
  "blocks": [
    { "type": "item", "name": "Ticker item", "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "New Arrivals" } ] }
  ],
  "presets": [
    {
      "name": "Marquee Ticker",
      "blocks": [
        { "type": "item", "settings": { "text": "New in" } },
        { "type": "item", "settings": { "text": "Made for you" } },
        { "type": "item", "settings": { "text": "Free shipping" } },
        { "type": "item", "settings": { "text": "Shop the collection" } }
      ]
    }
  ]
}
{% endschema %}
