<div class="story-hero">
  <div class="story-hero__bg">
    {% if section.settings.hero_image != blank %}
      <img
        src="{{ section.settings.hero_image | image_url: width: 2000 }}"
        alt="{{ section.settings.hero_image.alt | escape }}"
        loading="eager"
        width="{{ section.settings.hero_image.width }}"
        height="{{ section.settings.hero_image.height }}"
      >
    {% else %}
      <div style="width:100%;height:100%;background:var(--color-card);"></div>
    {% endif %}
  </div>
  <div class="story-hero__content">
    <p class="label reveal" style="color:rgba(255,255,255,0.6);margin-bottom:1rem;">{{ section.settings.eyebrow }}</p>
    <h1 class="heading-display reveal" style="color:#fff;">{{ section.settings.hero_heading }}</h1>
  </div>
</div>

<section class="story-section">
  <p class="story-section__index reveal">{{ section.settings.chapter_1_label }}</p>
  <h2 class="story-section__heading reveal">{{ section.settings.chapter_1_heading }}</h2>
  <div class="story-section__text reveal">
    {{ section.settings.chapter_1_text }}
  </div>
</section>

{% if section.settings.chapter_1_image != blank %}
  <div class="story-image-full reveal-scale">
    <img
      src="{{ section.settings.chapter_1_image | image_url: width: 2000 }}"
      alt="{{ section.settings.chapter_1_image.alt | escape }}"
      loading="lazy"
      width="{{ section.settings.chapter_1_image.width }}"
      height="{{ section.settings.chapter_1_image.height }}"
    >
  </div>
{% endif %}

<section class="story-section">
  <p class="story-section__index reveal">{{ section.settings.chapter_2_label }}</p>
  <h2 class="story-section__heading reveal">{{ section.settings.chapter_2_heading }}</h2>
  <div class="story-section__text reveal">
    {{ section.settings.chapter_2_text }}
  </div>
</section>

{% if section.settings.chapter_2_image != blank %}
  <div class="story-image-full reveal-scale">
    <img
      src="{{ section.settings.chapter_2_image | image_url: width: 2000 }}"
      alt="{{ section.settings.chapter_2_image.alt | escape }}"
      loading="lazy"
      width="{{ section.settings.chapter_2_image.width }}"
      height="{{ section.settings.chapter_2_image.height }}"
    >
  </div>
{% endif %}

{% schema %}
{
  "name": "About / Story",
  "tag": "section",
  "class": "section-about",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero background image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Our Story"
    },
    {
      "type": "text",
      "id": "hero_heading",
      "label": "Hero heading",
      "default": "Our story"
    },
    {
      "type": "text",
      "id": "chapter_1_label",
      "label": "Chapter 1 label",
      "default": "01 — Origin"
    },
    {
      "type": "text",
      "id": "chapter_1_heading",
      "label": "Chapter 1 heading",
      "default": "Where It\nBegan"
    },
    {
      "type": "richtext",
      "id": "chapter_1_text",
      "label": "Chapter 1 text",
      "default": "<p>Share how your brand began — the spark, the frustration, or the idea that started it all. Replace this with your own origin story.</p><p>Every brand has a beginning. Tell yours here.</p>"
    },
    {
      "type": "image_picker",
      "id": "chapter_1_image",
      "label": "Chapter 1 image"
    },
    {
      "type": "text",
      "id": "chapter_2_label",
      "label": "Chapter 2 label",
      "default": "02 — Process"
    },
    {
      "type": "text",
      "id": "chapter_2_heading",
      "label": "Chapter 2 heading",
      "default": "How We\nMake It"
    },
    {
      "type": "richtext",
      "id": "chapter_2_text",
      "label": "Chapter 2 text",
      "default": "<p>Describe how your product is made and what you stand for — your materials, your process, your values. Replace this with your own words.</p><p>Tell customers why it matters.</p>"
    },
    {
      "type": "image_picker",
      "id": "chapter_2_image",
      "label": "Chapter 2 image"
    }
  ],
  "presets": [
    {
      "name": "About / Story"
    }
  ]
}
{% endschema %}
