<div class="auth auth--wide">
  <a href="{{ routes.account_url }}" class="auth__link" style="margin-top:0;">← {{ 'customer.account.return' | t }}</a>
  <h1 class="auth__title" style="text-align:left;">{{ 'customer.order.title' | t: name: order.name }}</h1>
  {%- assign order_date = order.created_at | date: '%b %d, %Y %I:%M%p' -%}
  <p class="text-muted" style="margin-bottom:var(--spacing-lg);">{{ 'customer.order.date_html' | t: date: order_date }}</p>

  {%- if order.cancelled -%}
    {%- assign cancelled_date = order.cancelled_at | date: '%b %d, %Y' -%}
    <p class="form-errors">{{ 'customer.order.cancelled_html' | t: date: cancelled_date }}{% if order.cancel_reason %} — {{ 'customer.order.cancelled_reason' | t: reason: order.cancel_reason_label }}{% endif %}</p>
  {%- endif -%}

  <table class="account-table">
    <thead>
      <tr>
        <th>{{ 'customer.order.product' | t }}</th>
        <th>{{ 'customer.order.price' | t }}</th>
        <th>{{ 'customer.order.quantity' | t }}</th>
        <th>{{ 'customer.order.total' | t }}</th>
      </tr>
    </thead>
    <tbody>
      {%- for line_item in order.line_items -%}
        <tr>
          <td>
            <a href="{{ line_item.product.url }}">{{ line_item.title }}</a>
            {%- if line_item.fulfillment -%}
              {%- assign fulfilled_date = line_item.fulfillment.created_at | date: '%b %d, %Y' -%}
              <br><span class="text-muted" style="font-size:12px;">{{ 'customer.order.fulfilled_at_html' | t: date: fulfilled_date }}</span>
            {%- endif -%}
          </td>
          <td>{{ line_item.price | money }}</td>
          <td>{{ line_item.quantity }}</td>
          <td>{{ line_item.final_line_price | money }}</td>
        </tr>
      {%- endfor -%}
    </tbody>
    <tfoot>
      <tr><td colspan="3" style="text-align:right;">{{ 'customer.order.subtotal' | t | default: 'Subtotal' }}</td><td>{{ order.line_items_subtotal_price | money }}</td></tr>
      {%- for shipping_method in order.shipping_methods -%}
        <tr><td colspan="3" style="text-align:right;">{{ 'customer.order.shipping' | t }} ({{ shipping_method.title }})</td><td>{{ shipping_method.price | money }}</td></tr>
      {%- endfor -%}
      {%- for tax_line in order.tax_lines -%}
        <tr><td colspan="3" style="text-align:right;">{{ 'customer.order.tax' | t }} ({{ tax_line.title }})</td><td>{{ tax_line.price | money }}</td></tr>
      {%- endfor -%}
      <tr><td colspan="3" style="text-align:right;"><strong>{{ 'customer.order.total' | t }}</strong></td><td><strong>{{ order.total_net_amount | money }}</strong></td></tr>
    </tfoot>
  </table>

  <div class="account-grid" style="margin-top:var(--spacing-lg);">
    <div>
      <p class="account-block__title">{{ 'customer.order.shipping_address' | t }}</p>
      <div class="text-muted" style="font-size:14px;line-height:1.8;">{{ order.shipping_address | format_address }}</div>
    </div>
    <div>
      <p class="account-block__title">{{ 'customer.order.billing_address' | t }}</p>
      <div class="text-muted" style="font-size:14px;line-height:1.8;">{{ order.billing_address | format_address }}</div>
    </div>
  </div>
</div>
