<div class="auth">
  <h1 class="auth__title">{{ 'customer.reset_password.title' | t }}</h1>
  <p class="auth__subtext">{{ 'customer.activate_account.subtext' | t }}</p>

  {%- form 'reset_customer_password' -%}
    {%- if form.errors -%}
      <ul class="form-errors">
        {%- for field in form.errors -%}<li>{{ form.errors.messages[field] }}</li>{%- endfor -%}
      </ul>
    {%- endif -%}

    <div class="auth__field">
      <label class="auth__label" for="ResetPassword">{{ 'customer.activate_account.password' | t }}</label>
      <input type="password" name="customer[password]" id="ResetPassword" autocomplete="new-password" required>
    </div>
    <div class="auth__field">
      <label class="auth__label" for="ResetPasswordConfirm">{{ 'customer.activate_account.password_confirm' | t }}</label>
      <input type="password" name="customer[password_confirmation]" id="ResetPasswordConfirm" autocomplete="new-password" required>
    </div>

    <div class="auth__actions">
      <button type="submit" class="btn-add-to-cart"><span>{{ 'customer.reset_password.submit' | t }}</span></button>
    </div>
  {%- endform -%}
</div>
