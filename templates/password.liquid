<div style="text-align:center;">
  {%- if shop.password_message != blank -%}
    <p class="auth__subtext" style="margin-bottom:var(--spacing-md);">{{ shop.password_message }}</p>
  {%- endif -%}

  <h1 class="auth__title" style="font-size:clamp(2.5rem,8vw,5rem);">{{ shop.name }}</h1>
  <p class="auth__subtext">{{ 'general.password_page.login_form_heading' | t }}</p>

  {%- form 'storefront_password' -%}
    {%- if form.errors -%}
      <ul class="form-errors">{%- for field in form.errors -%}<li>{{ form.errors.messages[field] }}</li>{%- endfor -%}</ul>
    {%- endif -%}
    <div class="auth__field">
      <label class="auth__label" for="StorefrontPassword">{{ 'general.password_page.login_form_password_label' | t }}</label>
      <input type="password" name="password" id="StorefrontPassword" placeholder="{{ 'general.password_page.login_form_password_placeholder' | t }}" autocomplete="current-password" required>
    </div>
    <div class="auth__actions">
      <button type="submit" class="btn-add-to-cart"><span>{{ 'general.password_page.login_form_submit' | t }}</span></button>
    </div>
  {%- endform -%}

  <p class="auth__alt">{{ 'general.password_page.admin_link_html' | t }}</p>
</div>
