{% comment %} Usage: {% render 'product-card', product: product %} {% endcomment %}
{%- assign img1 = product.featured_image -%}
{%- assign img2 = product.images[1] -%}
{%- assign first_variant = product.selected_or_first_available_variant -%}

<article class="product-card reveal">
  <a href="{{ product.url }}" class="product-card__media">
    {% if img1 %}
      <img class="product-card__img product-card__img--primary"
           src="{{ img1 | image_url: width: 700 }}"
           srcset="{{ img1 | image_url: width: 400 }} 400w, {{ img1 | image_url: width: 700 }} 700w, {{ img1 | image_url: width: 1000 }} 1000w"
           sizes="(min-width:1100px) 25vw, (min-width:600px) 33vw, 50vw"
           alt="{{ img1.alt | escape }}" loading="lazy">
      {% if img2 %}
        <img class="product-card__img product-card__img--secondary"
             src="{{ img2 | image_url: width: 700 }}" alt="{{ img2.alt | escape }}" loading="lazy">
      {% endif %}
    {% else %}
      <div style="width:100%;height:100%;background:var(--color-card);"></div>
    {% endif %}

    {% if product.available == false %}
      <span class="product-card__badge">Sold Out</span>
    {% elsif product.compare_at_price > product.price %}
      <span class="product-card__badge">Sale</span>
    {% endif %}
  </a>

  {% if product.available %}
    <button class="product-card__quick"
            data-quick-add
            data-variant-id="{{ first_variant.id }}"
            data-url="{{ product.url }}">
      Quick Add — {{ product.price | money }}
    </button>
  {% endif %}

  <div class="product-card__info">
    <a href="{{ product.url }}"><h3 class="product-card__title">{{ product.title }}</h3></a>
    <div class="product-card__price{% if product.compare_at_price > product.price %} product-card__price--sale{% endif %}">
      <span>{{ product.price | money }}</span>
      {% if product.compare_at_price > product.price %}<s>{{ product.compare_at_price | money }}</s>{% endif %}
    </div>
  </div>
</article>
